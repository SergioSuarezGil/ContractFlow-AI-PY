# syntax=docker/dockerfile:1.7

FROM ghcr.io/astral-sh/uv:0.13.7 AS uv

FROM python:3.12.16-slim-bookworm AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy
WORKDIR /app
COPY --from=uv /uv /usr/local/bin/uv

FROM base AS deps
COPY pyproject.toml uv.lock .python-version ./
COPY apps ./apps
COPY packages ./packages
RUN uv sync --frozen --no-dev --package contractflow-contracts-api

FROM base AS runtime
RUN useradd --create-home --uid 10001 appuser
COPY --from=deps /app/.venv /app/.venv
COPY apps/contracts_api/src apps/contracts_api/src
COPY packages/shared/src packages/shared/src
COPY packages/contracts/src packages/contracts/src
COPY packages/contracts/schemas packages/contracts/schemas
COPY packages/observability/src packages/observability/src
COPY packages/grpc_contractflow/src packages/grpc_contractflow/src
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/apps/contracts_api/src:/app/packages/shared/src:/app/packages/contracts/src:/app/packages/observability/src:/app/packages/grpc_contractflow/src"
USER appuser
EXPOSE 3010
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=10 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:3010/health')"
CMD ["uvicorn", "contracts_api.main:app", "--host", "0.0.0.0", "--port", "3010"]
