# syntax=docker/dockerfile:1.7

FROM ghcr.io/astral-sh/uv:0.13.7 AS uv

FROM python:3.12.16-slim-bookworm AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy
WORKDIR /app
COPY --from=uv /uv /usr/local/bin/uv

FROM base AS deps
COPY pyproject.toml uv.lock .python-version ./
COPY apps ./apps
COPY packages ./packages
RUN uv sync --frozen --no-dev --package contractflow-pdf-worker

FROM base AS runtime
RUN useradd --create-home --uid 10001 appuser
COPY --from=deps /app/.venv /app/.venv
COPY apps/pdf_worker/src apps/pdf_worker/src
COPY packages/shared/src packages/shared/src
COPY packages/contracts/src packages/contracts/src
COPY packages/contracts/schemas packages/contracts/schemas
COPY packages/observability/src packages/observability/src
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/apps/pdf_worker/src:/app/packages/shared/src:/app/packages/contracts/src:/app/packages/observability/src" \
    PDF_WORKER_PORT=3012 \
    PDF_WORKER_CONSUME=true \
    MESSAGING=rabbit
USER appuser
EXPOSE 3012
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=8 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:3012/health')"
CMD ["uvicorn", "pdf_worker.main:app", "--host", "0.0.0.0", "--port", "3012"]
