# ContractFlow AI (Python) — local demo template
# Copy to .env (gitignored). Never commit real secrets.

ENVIRONMENT=development
APP_NAME=contractflow-ai-py
LLM_PROVIDER=mock
AUTH_MODE=dev
# For real Keycloak: AUTH_MODE=oidc and set OIDC_* below
CONTRACTS_REPO=memory
# CONTRACTS_REPO=mongo
OBJECT_STORAGE=memory
# OBJECT_STORAGE=s3
# DOCUMENT_SOURCE=memory|http|mongo
# COMPARISON_STORE=memory|mongo
# PDF_STORAGE=memory|s3
# AI_WORKER_GRPC_ENABLED=false
# AI_WORKER_GRPC_PORT=50052
# AI_WORKER_GRPC_TARGET=127.0.0.1:50052
MESSAGING=noop
# MESSAGING=rabbit
# AI_WORKER_CONSUME=true
# PDF_WORKER_CONSUME=true
OUTBOX_ENABLED=true
OUTBOX_POLL_MS=500
S3_BUCKET_DOCUMENTS=documents
S3_BUCKET_REPORTS=reports
DEV_OWNER_ID=demo
DEV_HOUSEHOLD_ID=hh_demo

# Internal worker ↔ API bridge (Compose sets these automatically)
INTERNAL_API_TOKEN=dev-internal
# DOCUMENT_SOURCE=http
# DOCUMENT_SOURCE=mongo
# CONTRACTS_API_INTERNAL_URL=http://127.0.0.1:3010
# LOG_FORMAT=json

# Gemini (optional; leave empty while mock)
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# contracts-api host port (TS stack uses 3000)
CONTRACTS_API_PORT=3010

# Shared infra credentials (same defaults as ContractFlow-AI-TS)
RABBITMQ_DEFAULT_USER=contractflow
RABBITMQ_DEFAULT_PASS=contractflow
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
S3_ACCESS_KEY=test
S3_SECRET_KEY=test

# Host-side apps (after ./scripts/infra_up.sh)
MONGODB_URI=mongodb://localhost:27017/contractflow?directConnection=true
RABBITMQ_URL=amqp://contractflow:contractflow@localhost:5672
S3_ENDPOINT=localhost
S3_PORT=4566
OIDC_ISSUER=http://localhost:8080/realms/contractflow
OIDC_AUDIENCE=contractflow-web
# Inside Compose PY apps, override to service DNS (see infra/compose.python.yaml)
